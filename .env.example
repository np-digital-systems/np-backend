NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1

DATABASE_URL=postgresql://np:np@127.0.0.1:5433/np_digital?schema=public
# SHADOW_DATABASE_URL is optional: Prisma creates a temporary shadow database
# automatically when the connecting role may CREATE DATABASE.
# SHADOW_DATABASE_URL=postgresql://np:np@127.0.0.1:5433/np_digital_shadow?schema=public
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000

REDIS_URL=redis://127.0.0.1:6380
REDIS_KEY_PREFIX=np:
CACHE_TTL_SECONDS=60

JWT_ACCESS_SECRET=replace-me-with-a-32-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-32-byte-random-string
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_MS=20000
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
LOG_LEVEL=debug
SWAGGER_ENABLED=true
