generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  accountant
  cashier
  user

  @@map("user_role")
}

enum AccountType {
  asset
  liability
  equity
  income
  expense

  @@map("account_type")
}

enum ProjectStatus {
  planning
  active
  onHold    @map("on-hold")
  completed

  @@map("project_status")
}

enum BankAccountType {
  current
  savings
  fixedDeposit @map("fixed-deposit")

  @@map("bank_account_type")
}

enum VoucherKind {
  receipt
  payment

  @@map("voucher_kind")
}

enum VoucherStatus {
  Draft
  PendingApproval @map("Pending Approval")
  Approved
  Rejected
  Posted
  Cancelled

  @@map("voucher_status")
}

enum PaymentMode {
  cash
  bank
  cheque
  online

  @@map("payment_mode")
}

enum DepositStatus {
  active
  matured
  renewed
  closed

  @@map("deposit_status")
}

enum InterestPayout {
  monthly
  quarterly
  onMaturity @map("on-maturity")

  @@map("interest_payout")
}

enum AssetCategory {
  landBuilding @map("land-building")
  jewellery
  vahanam
  vessels
  furniture
  equipment
  vehicle

  @@map("asset_category")
}

enum AssetCondition {
  good
  fair
  needsRepair @map("needs-repair")
  unusable

  @@map("asset_condition")
}

enum AssetStatus {
  inUse       @map("in-use")
  inStorage   @map("in-storage")
  underRepair @map("under-repair")
  disposed

  @@map("asset_status")
}

enum FrequencyType {
  weekly
  monthly_twice
  monthly_once
  annual
  multi_day

  @@map("frequency_type")
}

/*
 * What an activity is, so the list can be grouped and filtered. A pooja is the
 * one every temple has; the rest exist so hall rental and general upkeep have
 * somewhere to sit without a schema change.
 */
enum ActivityKind {
  pooja
  service
  facility
  general

  @@map("activity_kind")
}

/*
 * Where a party stands in relation to the temple. Kept deliberately coarse —
 * a person may sponsor a pooja one year and supply flowers the next, and the
 * label is for grouping a list, not for controlling what they may appear on.
 */
enum PartyKind {
  sponsor
  staff
  vendor
  devotee

  @@map("party_kind")
}

enum FinancialYearStatus {
  open
  closed
  upcoming

  @@map("financial_year_status")
}

enum AuditAction {
  create
  update
  delete
  approve
  reject
  post
  login
  logout
  permissionChange @map("permission-change")

  @@map("audit_action")
}

enum NotificationCategory {
  Approval
  Accounting
  Event
  Sanththa
  Banking
  FixedDeposit       @map("Fixed Deposit")
  FinancialYear      @map("Financial Year")
  UserAdministration @map("User Administration")
  Security
  System

  @@map("notification_category")
}

enum NotificationPriority {
  Information
  Reminder
  Warning
  Critical

  @@map("notification_priority")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameTa       String    @map("name_ta")
  fullName     String?   @map("full_name")
  email        String?   @unique(map: "users_email_key") @db.Citext
  passwordHash String?   @map("password_hash")
  phone        String?
  address      String    @default("")
  role         UserRole  @default(user)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  memberNo     String?   @unique(map: "users_member_no_key") @map("member_no")
  joinedOn     DateTime? @map("joined_on") @db.Date
  subscribes   Boolean   @default(false)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions            UserSession[]
  closedFinancialYear FinancialYear[]
  vouchersCreated     Voucher[]             @relation("VoucherCreatedBy")
  vouchersDecided     Voucher[]             @relation("VoucherDecidedBy")
  subscriptionsPaid   SanththaPayment[]     @relation("SanththaPayer")
  subscriptionsTaken  SanththaPayment[]     @relation("SanththaCollector")
  auditEntries        AuditLog[]
  notifications       NotificationRecipient[]
  settingsUpdated     Setting[]
  party               Party?

  @@map("users")
}

model UserSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "user_sessions_token_hash_key") @map("token_hash")
  deviceName String    @map("device_name")
  ipAddress  String    @map("ip_address") @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "user_sessions_expiry")
  @@map("user_sessions")
}

model Role {
  code        UserRole @id
  label       String
  description String
  isSystem    Boolean  @default(false) @map("is_system")
  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt

  permissions RolePermission[]

  @@map("roles")
}

model PermissionGroup {
  code        String @id
  label       String
  description String
  sortOrder   Int    @default(0) @map("sort_order") @db.SmallInt

  permissions Permission[]

  @@map("permission_groups")
}

model Permission {
  code      String @id
  groupCode String @map("group_code")
  label     String
  sortOrder Int    @default(0) @map("sort_order") @db.SmallInt

  group PermissionGroup  @relation(fields: [groupCode], references: [code])
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleCode       UserRole @map("role_code")
  permissionCode String   @map("permission_code")

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

model FinancialYear {
  id             Int                 @id @default(autoincrement())
  label          String              @unique(map: "financial_years_label_key")
  startsOn       DateTime            @map("starts_on") @db.Date
  endsOn         DateTime            @map("ends_on") @db.Date
  status         FinancialYearStatus @default(upcoming)
  isCurrent      Boolean             @default(false) @map("is_current")
  openingBalance Decimal             @default(0) @map("opening_balance") @db.Decimal(14, 2)
  income         Decimal?            @db.Decimal(14, 2)
  expenses       Decimal?            @db.Decimal(14, 2)
  voucherCount   Int?                @map("voucher_count")
  closedOn       DateTime?           @map("closed_on") @db.Timestamptz(6)
  closedBy       String?             @map("closed_by") @db.Uuid

  closedByUser User?             @relation(fields: [closedBy], references: [id])
  vouchers     Voucher[]
  sequences    VoucherSequence[]

  @@map("financial_years")
}

model Account {
  id             Int         @id @default(autoincrement())
  code           String      @unique(map: "accounts_code_key")
  nameTa         String      @map("name_ta")
  nameEn         String?     @map("name_en")
  type           AccountType
  parentId       Int?        @map("parent_id")
  isPostable     Boolean     @default(true) @map("is_postable")
  isActive       Boolean     @default(true) @map("is_active")
  openingBalance Decimal     @default(0) @map("opening_balance") @db.Decimal(14, 2)
  // Offered when this head is chosen. A kurukkal honorarium is always paid to
  // the same person, so the head remembers rather than the clerk retyping.
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  parent       Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountTree")
  bankAccount  BankAccount?
  voucherLines VoucherLine[]
  ledgerLines  LedgerEntry[]

  @@index([parentId], map: "accounts_parent")
  @@map("accounts")
}

model Fund {
  id             Int      @id @default(autoincrement())
  nameTa         String   @unique(map: "funds_name_ta_key") @map("name_ta")
  nameEn         String?  @map("name_en")
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  projects     Project[]
  voucherLines VoucherLine[]
  ledgerLines  LedgerEntry[]
  deposits     FixedDeposit[]
  assets       Asset[]
  activities   Activity[]

  @@map("funds")
}

model Project {
  id          Int           @id @default(autoincrement())
  nameTa      String        @map("name_ta")
  nameEn      String?       @map("name_en")
  fundId      Int           @map("fund_id")
  budget      Decimal?      @db.Decimal(14, 2)
  startDate   DateTime      @map("start_date") @db.Date
  targetDate  DateTime?     @map("target_date") @db.Date
  status      ProjectStatus @default(planning)
  description String        @default("")
  isActive    Boolean       @default(true) @map("is_active")

  fund         Fund          @relation(fields: [fundId], references: [id])
  voucherLines VoucherLine[]
  ledgerLines  LedgerEntry[]
  activities   Activity[]

  @@index([fundId, status], map: "projects_fund")
  @@map("projects")
}

/*
 * An activity: what an entry was for.
 *
 * The temple's answer to a cost centre. Both income and expenditure carry one,
 * which is what lets a pooja be read as a whole — sponsorship in against
 * priest time out — where an income head alone can only ever show one side.
 *
 * A new pooja, a new festival, a hall let out for a wedding: each is a row
 * somebody adds, never a column somebody migrates.
 */
model Activity {
  id            Int          @id @default(autoincrement())
  nameTa        String       @unique(map: "activities_name_ta_key") @map("name_ta")
  nameEn        String?      @map("name_en")
  kind          ActivityKind @default(general)
  /*
   * The coding a line takes when this activity is chosen, answered once here
   * instead of on every voucher. All three stay editable on the entry itself:
   * a default is what is usually true, never a rule.
   *
   * The party sits here rather than on the ledger head because a head is too
   * coarse to know — `5200 Salaries` serves the kurukkal, the melam group and
   * the chef, while an activity is only ever one of them.
   */
  defaultFundId    Int?      @map("default_fund_id")
  defaultProjectId Int?      @map("default_project_id")
  defaultPartyId   Int?      @map("default_party_id")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  defaultFund    Fund?    @relation(fields: [defaultFundId], references: [id])
  defaultProject Project? @relation(fields: [defaultProjectId], references: [id])
  defaultParty   Party?   @relation(fields: [defaultPartyId], references: [id])
  eventTypes   EventType[]
  voucherLines VoucherLine[]
  ledgerLines  LedgerEntry[]

  @@index([kind, isActive], map: "activities_kind")
  @@index([defaultFundId], map: "activities_default_fund")
  @@index([defaultProjectId], map: "activities_default_project")
  @@index([defaultPartyId], map: "activities_default_party")
  @@map("activities")
}

/*
 * A party: who an entry was with.
 *
 * The subsidiary ledger. People never become heads in the chart of accounts —
 * the chart says what kind of money moved, a party says who it moved with —
 * so one `5200 Salaries` head serves every kurukkal and melam player, and
 * "what did we pay him this year" is a grouping rather than another account.
 *
 * `userId` is set for anyone who also signs in, which is how a sponsor on the
 * calendar and a payer on a receipt are known to be the same person. A vendor
 * who will never log in simply has none.
 */
model Party {
  id        Int      @id @default(autoincrement())
  nameTa    String   @map("name_ta")
  nameEn    String?  @map("name_en")
  userId    String?  @unique(map: "parties_user_id_key") @map("user_id") @db.Uuid
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user                 User?              @relation(fields: [userId], references: [id])
  roles                PartyRole[]
  vouchers             Voucher[]
  ledgerLines          LedgerEntry[]
  defaultForActivities Activity[]
  sponsorships         EventTypeSponsor[]
  eventsSponsored      Event[]

  @@index([isActive], map: "parties_active")
  @@index([nameTa(ops: raw("gin_trgm_ops"))], map: "parties_name", type: Gin)
  @@map("parties")
}

/*
 * What a party is to the temple, as a set rather than a single label.
 *
 * One person may sponsor the Friday abhishekam and sell the temple its flowers.
 * That is two roles of one party, not two parties — filing them separately
 * would split their history in half and leave no screen able to say what the
 * temple's dealings with them amount to.
 *
 * The role groups a list and nothing more. What an entry means is settled by
 * the account it is coded to, never by this.
 */
model PartyRole {
  partyId Int       @map("party_id")
  kind    PartyKind

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@id([partyId, kind])
  @@index([kind], map: "party_roles_kind")
  @@map("party_roles")
}

model BankAccount {
  id              Int             @id @default(autoincrement())
  label           String
  bankName        String          @map("bank_name")
  branch          String
  accountNumber   String          @map("account_number")
  type            BankAccountType
  openingBalance  Decimal         @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openedOn        DateTime        @map("opened_on") @db.Date
  isActive        Boolean         @default(true) @map("is_active")
  ledgerAccountId Int             @unique(map: "bank_accounts_ledger_account_id_key") @map("ledger_account_id")

  ledgerAccount Account        @relation(fields: [ledgerAccountId], references: [id])
  vouchers      Voucher[]
  ledgerLines   LedgerEntry[]
  deposits      FixedDeposit[]

  @@unique([bankName, accountNumber], map: "bank_account_number")
  @@map("bank_accounts")
}

model Voucher {
  id              BigInt        @id @default(autoincrement())
  ref             String        @unique(map: "vouchers_ref_key")
  kind            VoucherKind
  financialYearId Int           @map("financial_year_id")
  date            DateTime      @db.Date
  description     String
  // The document total, summed from its lines. Stored rather than derived so
  // a register of five thousand vouchers does not aggregate to list them.
  amount          Decimal       @db.Decimal(14, 2)
  mode            PaymentMode
  bankAccountId   Int?          @map("bank_account_id")
  chequeNo        String?       @map("cheque_no")
  // Who the entry was with. On the header rather than the lines: a receipt has
  // one payer even when it is split across three heads.
  partyId         Int?          @map("party_id")
  // The name as it stood when the entry was made. Kept alongside partyId so a
  // walk-in donor needs no record, and so a party later renamed or reassigned
  // cannot rewrite what a posted receipt says.
  party           String
  manualVoucherNo String?       @map("manual_voucher_no")
  status          VoucherStatus @default(Draft)
  notes           String?
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt     DateTime?     @map("submitted_at") @db.Timestamptz(6)
  decidedBy       String?       @map("decided_by") @db.Uuid
  decidedAt       DateTime?     @map("decided_at") @db.Timestamptz(6)
  rejectionReason String?       @map("rejection_reason")
  postedAt        DateTime?     @map("posted_at") @db.Timestamptz(6)

  financialYear   FinancialYear     @relation(fields: [financialYearId], references: [id])
  partyRef        Party?            @relation(fields: [partyId], references: [id])
  bankAccount     BankAccount?      @relation(fields: [bankAccountId], references: [id])
  lines           VoucherLine[]
  createdByUser   User              @relation("VoucherCreatedBy", fields: [createdBy], references: [id])
  decidedByUser   User?             @relation("VoucherDecidedBy", fields: [decidedBy], references: [id])
  ledgerEntries   LedgerEntry[]
  sanththaPayment SanththaPayment?

  @@index([financialYearId, date(sort: Desc)], map: "vouchers_year_date")
  @@index([kind, date(sort: Desc)], map: "vouchers_kind_date")
  @@index([partyId], map: "vouchers_party")
  @@index([bankAccountId], map: "vouchers_bank_account")
  @@index([createdBy], map: "vouchers_created_by")
  @@index([party(ops: raw("gin_trgm_ops"))], map: "vouchers_party_text", type: Gin)
  @@map("vouchers")
}

/*
 * One head a voucher is coded to, and the amount going to it.
 *
 * A receipt for five thousand rupees of which two are earmarked for annadhanam
 * is one document with two lines — one reference, one signature, one piece of
 * paper — where before it could only be two vouchers pretending to be
 * unrelated.
 *
 * There is no debit/credit column here because a voucher is not a general
 * journal: every line of a receipt is a credit to income, every line of a
 * payment a debit to expenditure, and the side follows from `voucher.kind`.
 * The contra against cash or bank is generated at posting, split by fund so
 * each fund's cash balances within itself.
 */
model VoucherLine {
  id         BigInt   @id @default(autoincrement())
  voucherId  BigInt   @map("voucher_id")
  lineNo     Int      @map("line_no") @db.SmallInt
  accountId  Int      @map("account_id")
  amount     Decimal  @db.Decimal(14, 2)
  fundId     Int      @map("fund_id")
  projectId  Int?     @map("project_id")
  activityId Int?     @map("activity_id")
  // The occurrence this line is for, where the activity alone is not precise
  // enough — which Friday, not merely that it was a Friday abhishekam.
  eventId    Int?     @map("event_id")

  voucher  Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id])
  fund     Fund      @relation(fields: [fundId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id])
  activity Activity? @relation(fields: [activityId], references: [id])
  event    Event?    @relation(fields: [eventId], references: [id])

  @@unique([voucherId, lineNo], map: "voucher_line_no")
  @@index([accountId], map: "voucher_lines_account")
  @@index([activityId], map: "voucher_lines_activity")
  @@index([fundId], map: "voucher_lines_fund")
  @@index([projectId], map: "voucher_lines_project")
  @@index([eventId], map: "voucher_lines_event")
  @@map("voucher_lines")
}

model VoucherSequence {
  financialYearId Int         @map("financial_year_id")
  kind            VoucherKind
  prefix          String
  nextNo          Int         @default(1) @map("next_no")

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@id([financialYearId, kind])
  @@map("voucher_sequences")
}

model LedgerEntry {
  id            BigInt   @id @default(autoincrement())
  voucherId     BigInt   @map("voucher_id")
  lineNo        Int      @map("line_no") @db.SmallInt
  date          DateTime @db.Date
  accountId     Int      @map("account_id")
  fundId        Int      @map("fund_id")
  projectId     Int?     @map("project_id")
  // Carried only on the income or expense line, never on its cash or bank
  // contra. Both sides bearing the same activity would net to nil and every
  // activity would report zero.
  activityId    Int?     @map("activity_id")
  partyId       Int?     @map("party_id")
  debit         Decimal? @db.Decimal(14, 2)
  credit        Decimal? @db.Decimal(14, 2)
  bankAccountId Int?     @map("bank_account_id")

  voucher     Voucher      @relation(fields: [voucherId], references: [id])
  account     Account      @relation(fields: [accountId], references: [id])
  fund        Fund         @relation(fields: [fundId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id])
  activity    Activity?    @relation(fields: [activityId], references: [id])
  party       Party?       @relation(fields: [partyId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@unique([voucherId, lineNo], map: "voucher_line")
  @@index([accountId, date], map: "ledger_account_date")
  @@index([fundId, date], map: "ledger_fund_date")
  @@index([projectId], map: "ledger_entries_project")
  @@index([bankAccountId], map: "ledger_entries_bank_account")
  @@index([activityId, date], map: "ledger_activity_date")
  @@index([partyId, date], map: "ledger_party_date")
  @@index([date], map: "ledger_date")
  @@map("ledger_entries")
}

model FixedDeposit {
  id             Int            @id @default(autoincrement())
  certificateNo  String         @unique(map: "fixed_deposits_certificate_no_key") @map("certificate_no")
  bankName       String         @map("bank_name")
  branch         String
  principal      Decimal        @db.Decimal(14, 2)
  interestRate   Decimal        @map("interest_rate") @db.Decimal(5, 2)
  placedOn       DateTime       @map("placed_on") @db.Date
  maturesOn      DateTime       @map("matures_on") @db.Date
  tenureMonths   Int            @map("tenure_months") @db.SmallInt
  interestPayout InterestPayout @map("interest_payout")
  fundId         Int            @map("fund_id")
  status         DepositStatus  @default(active)
  renewedFromId  Int?           @map("renewed_from_id")
  bankAccountId  Int?           @map("bank_account_id")
  notes          String?

  fund        Fund           @relation(fields: [fundId], references: [id])
  bankAccount BankAccount?   @relation(fields: [bankAccountId], references: [id])
  renewedFrom FixedDeposit?  @relation("DepositRenewal", fields: [renewedFromId], references: [id])
  renewals    FixedDeposit[] @relation("DepositRenewal")

  @@index([status, maturesOn], map: "deposits_maturing")
  @@map("fixed_deposits")
}

model Asset {
  id               Int            @id @default(autoincrement())
  tag              String         @unique(map: "assets_tag_key")
  nameTa           String         @map("name_ta")
  nameEn           String?        @map("name_en")
  category         AssetCategory
  acquiredOn       DateTime       @map("acquired_on") @db.Date
  cost             Decimal        @db.Decimal(14, 2)
  depreciationRate Decimal        @default(0) @map("depreciation_rate") @db.Decimal(5, 2)
  location         String
  condition        AssetCondition @default(good)
  status           AssetStatus    @default(inUse)
  fundId           Int            @map("fund_id")
  disposedOn       DateTime?      @map("disposed_on") @db.Date
  disposalValue    Decimal?       @map("disposal_value") @db.Decimal(14, 2)
  notes            String?

  fund Fund @relation(fields: [fundId], references: [id])

  @@index([category, status], map: "assets_category")
  @@map("assets")
}

model EventType {
  id            Int           @id @default(autoincrement())
  nameTa        String        @unique(map: "event_types_name_ta_key") @map("name_ta")
  nameEn        String?       @map("name_en")
  frequencyType FrequencyType @map("frequency_type")
  noOfInstances Int           @default(1) @map("no_of_instances") @db.SmallInt
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // The activity a receipt for this pooja is coded to. The activity carries
  // the fund in turn, so choosing the pooja settles both.
  activityId Int? @map("activity_id")

  activity Activity? @relation(fields: [activityId], references: [id])

  slots EventSlot[]

  @@index([activityId], map: "event_types_activity")
  @@map("event_types")
}

/// A sponsor is a person registered against an event type. The instance is
/// optional: leaving it null means they sponsor the type as a whole and are
/// offered for any of its instances, rather than one particular slot.
/*
 * One slot of a recurring observance — Week 12, or the மார்கழி occurrence.
 *
 * The structure of the temple year, fixed once and left alone. Sponsors attach
 * to a slot and a slot is dated afresh every year, so this is the row both of
 * those point at: the name of a slot is neither a property of whoever takes it
 * nor of the day it happens to land on, and holding it here is what stops the
 * same name being written on two tables with a rule deciding which wins.
 */
model EventSlot {
  id                 Int     @id @default(autoincrement())
  eventTypeId        Int     @map("event_type_id")
  instanceIdentifier Int     @map("instance_identifier") @db.SmallInt
  // The temple's own name for the slot — "மார்கழி மாதம்", "சப்பரம்".
  customInstanceName String? @map("custom_instance_name")
  isActive           Boolean @default(true) @map("is_active")

  eventType EventType          @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  sponsors  EventTypeSponsor[]
  events    Event[]

  // The natural key, beside the surrogate id the other tables reference.
  @@unique([eventTypeId, instanceIdentifier], map: "one_slot_per_instance")
  @@map("event_slots")
}

/*
 * Who may take a slot — the arrangement, with no year attached.
 *
 * A shortlist, not an order: several devotees share one slot between them, and
 * which of them takes a given year is decided when that year is scheduled and
 * recorded on the occurrence. Storing a turn order here would be a second
 * opinion that drifts the first time a year is skipped or swapped.
 *
 * Always a slot. Every type has them, so "all instances" was a way of saying
 * "all of these" that nothing could act on — the schedule had to fan it back
 * out to the slots anyway, and it left a nullable link that only ever meant
 * the same thing as a row per slot.
 */
model EventTypeSponsor {
  id        Int      @id @default(autoincrement())
  slotId    Int      @map("slot_id")
  partyId   Int      @map("party_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  slot  EventSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  party Party     @relation(fields: [partyId], references: [id])

  @@unique([slotId, partyId], map: "one_sponsor_per_slot")
  @@index([partyId], map: "sponsors_by_party")
  @@map("event_type_sponsors")
}

/*
 * One dated occurrence of one slot — the part redrawn every year.
 *
 * Everything fixed lives on the slot; what changes each year is the date, the
 * time, and which of the slot's sponsors took it. That last one is why the
 * sponsor sits here and not on the slot: the slot knows all three names, only
 * the year knows which of them paid.
 */
model Event {
  id                 Int       @id @default(autoincrement())
  slotId             Int       @map("slot_id")
  scheduledDate      DateTime  @map("scheduled_date") @db.Date
  startTime          DateTime  @map("start_time") @db.Time(6)
  endTime            DateTime? @map("end_time") @db.Time(6)
  sponsorPartyId     Int?      @map("sponsor_party_id")
  notes              String?
  isCompleted        Boolean   @default(false) @map("is_completed")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  slot         EventSlot     @relation(fields: [slotId], references: [id])
  sponsor      Party?        @relation(fields: [sponsorPartyId], references: [id])
  voucherLines VoucherLine[]

  // The same slot on the same day twice is a duplicate, not a second pooja.
  @@unique([slotId, scheduledDate], map: "one_occurrence_per_slot_day")
  @@index([scheduledDate], map: "events_calendar")
  @@index([sponsorPartyId], map: "events_sponsor")
  @@map("events")
}

model SanththaPayment {
  id               Int         @id @default(autoincrement())
  userId           String      @map("user_id") @db.Uuid
  year             Int
  amount           Decimal     @db.Decimal(12, 2)
  paidOn           DateTime    @map("paid_on") @db.Date
  receiptVoucherId BigInt?     @unique(map: "one_payment_per_receipt") @map("receipt_voucher_id")
  mode             PaymentMode
  collectedBy      String      @map("collected_by") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User     @relation("SanththaPayer", fields: [userId], references: [id])
  collectedByUser User    @relation("SanththaCollector", fields: [collectedBy], references: [id])
  receiptVoucher Voucher? @relation(fields: [receiptVoucherId], references: [id])

  @@unique([userId, year], map: "one_payment_per_member_per_year")
  @@index([year], map: "payments_year")
  @@index([userId], map: "payments_member")
  @@map("sanththa_payments")
}

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  at        DateTime    @default(now()) @db.Timestamptz(6)
  actorId   String?     @map("actor_id") @db.Uuid
  actorName String      @map("actor_name")
  actorRole UserRole    @map("actor_role")
  action    AuditAction
  entity    String
  entityRef String?     @map("entity_ref")
  summary   String
  ipAddress String      @map("ip_address") @db.Inet
  diff      Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at(sort: Desc)], map: "audit_recent")
  @@index([actorId, at(sort: Desc)], map: "audit_actor")
  @@index([entity, entityRef], map: "audit_entity")
  @@map("audit_log")
}

model Notification {
  id          BigInt               @id @default(autoincrement())
  category    NotificationCategory
  priority    NotificationPriority @default(Information)
  title       String
  message     String
  entityType  String?              @map("entity_type")
  entityRef   String?              @map("entity_ref")
  actionLabel String?              @map("action_label")
  actionHref  String?              @map("action_href")
  meta        Json?
  dismissible Boolean              @default(true)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  recipients NotificationRecipient[]

  @@index([createdAt(sort: Desc)], map: "notifications_recent")
  @@map("notifications")
}

model NotificationRecipient {
  notificationId BigInt    @map("notification_id")
  userId         String    @map("user_id") @db.Uuid
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  dismissedAt    DateTime? @map("dismissed_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@map("notification_recipients")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  updatedByUser User? @relation(fields: [updatedBy], references: [id])

  @@map("settings")
}
