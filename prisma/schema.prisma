generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// What a sign-in may do. Everyone outside staff shares `member`; what the
/// portal shows them is derived from their party, not from this.
enum AccountRole {
  admin
  accountant
  cashier
  member

  @@map("account_role")
}

enum PartyType {
  person
  organisation

  @@map("party_type")
}

/// What a party is to the temple, as a set rather than a single label.
/// There is no `sponsor` here: a row in `sponsors` is the sponsor role.
enum PartyKind {
  devotee
  vendor
  staff

  @@map("party_kind")
}

enum AccountType {
  asset
  liability
  equity
  income
  expense

  @@map("account_type")
}

enum ProjectStatus {
  planning
  active
  onHold    @map("on-hold")
  completed

  @@map("project_status")
}

enum BankAccountType {
  current
  savings
  fixedDeposit @map("fixed-deposit")

  @@map("bank_account_type")
}

enum VoucherKind {
  receipt
  payment

  @@map("voucher_kind")
}

enum VoucherStatus {
  Draft
  PendingApproval @map("Pending Approval")
  Approved
  Rejected
  Posted
  Cancelled

  @@map("voucher_status")
}

enum PaymentMode {
  cash
  bank
  cheque
  online

  @@map("payment_mode")
}

enum DepositStatus {
  active
  matured
  renewed
  closed

  @@map("deposit_status")
}

enum InterestPayout {
  monthly
  quarterly
  onMaturity @map("on-maturity")

  @@map("interest_payout")
}

enum AssetCategory {
  landBuilding @map("land-building")
  jewellery
  vahanam
  vessels
  furniture
  equipment
  vehicle

  @@map("asset_category")
}

enum AssetCondition {
  good
  fair
  needsRepair @map("needs-repair")
  unusable

  @@map("asset_condition")
}

enum AssetStatus {
  inUse       @map("in-use")
  inStorage   @map("in-storage")
  underRepair @map("under-repair")
  disposed

  @@map("asset_status")
}

enum FrequencyType {
  weekly
  monthly_twice
  monthly_once
  annual
  multi_day

  @@map("frequency_type")
}

enum ActivityKind {
  pooja
  service
  facility
  general

  @@map("activity_kind")
}

/// How an observance is paid for. `general` means a village collection with no
/// named sponsor, which is why its occurrences carry a null sponsor by design
/// rather than by omission.
enum EventFunding {
  sponsored
  general

  @@map("event_funding")
}

enum FinancialYearStatus {
  open
  closed
  upcoming

  @@map("financial_year_status")
}

enum AuditAction {
  create
  update
  delete
  approve
  reject
  post
  login
  logout
  permissionChange @map("permission-change")

  @@map("audit_action")
}

enum NotificationCategory {
  Approval
  Accounting
  Event
  Sanththa
  Banking
  FixedDeposit       @map("Fixed Deposit")
  FinancialYear      @map("Financial Year")
  UserAdministration @map("User Administration")
  Security
  System

  @@map("notification_category")
}

enum NotificationPriority {
  Information
  Reminder
  Warning
  Critical

  @@map("notification_priority")
}

/// Everyone and everything the temple deals with, and the only place a name is
/// stored. Contact columns are all optional: the electricity board has an
/// account number and no phone, a walk-in donor has a name and nothing else.
model Party {
  id          Int       @id @default(autoincrement())
  type        PartyType @default(person)
  nameTa      String    @map("name_ta")
  nameEn      String?   @map("name_en")
  phone       String?
  email       String?
  address     String?
  /// Their account number with us, or ours with them.
  referenceNo String?   @map("reference_no")
  notes       String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles                PartyRole[]
  sponsor              Sponsor?
  account              UserAccount?
  vouchers             Voucher[]
  ledgerLines          LedgerEntry[]
  defaultForActivities Activity[]         @relation("ActivityDefaultParty")
  defaultForAccounts   Account[]          @relation("AccountDefaultParty")
  sponsorships         EventTypeSponsor[]
  eventsSponsored      Event[]

  @@index([isActive], map: "parties_active")
  @@index([type], map: "parties_type")
  @@index([nameTa(ops: raw("gin_trgm_ops"))], map: "parties_name", type: Gin)
  @@map("parties")
}

model PartyRole {
  partyId Int       @map("party_id")
  kind    PartyKind

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@id([partyId, kind])
  @@index([kind], map: "party_roles_kind")
  @@map("party_roles")
}

/// A sponsor profile. The primary key is the foreign key, so the 1:1 with a
/// party cannot be broken and no name is stored twice.
model Sponsor {
  partyId      Int      @id @map("party_id")
  sponsorNo    String   @unique(map: "sponsors_sponsor_no_key") @map("sponsor_no")
  sponsorSince DateTime @map("sponsor_since") @db.Date
  subscribes   Boolean  @default(true)
  isActive     Boolean  @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  party    Party             @relation(fields: [partyId], references: [id], onDelete: Cascade)
  payments SanththaPayment[]

  @@index([isActive], map: "sponsors_active")
  @@map("sponsors")
}

/// The subscription due from every sponsor for a year. Held per year so raising
/// the rate cannot restate what an earlier year charged.
model SanththaRate {
  year   Int      @id
  amount Decimal  @db.Decimal(12, 2)
  setBy  String?  @map("set_by") @db.Uuid
  setAt  DateTime @default(now()) @map("set_at") @db.Timestamptz(6)

  setByAccount UserAccount? @relation(fields: [setBy], references: [id])

  @@map("sanththa_rates")
}

model SanththaPayment {
  id               Int         @id @default(autoincrement())
  sponsorId        Int         @map("sponsor_id")
  year             Int
  amount           Decimal     @db.Decimal(12, 2)
  paidOn           DateTime    @map("paid_on") @db.Date
  receiptVoucherId BigInt?     @unique(map: "one_payment_per_receipt") @map("receipt_voucher_id")
  mode             PaymentMode
  collectedBy      String      @map("collected_by") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  sponsor          Sponsor     @relation(fields: [sponsorId], references: [partyId])
  collectedByUser  UserAccount @relation("SanththaCollector", fields: [collectedBy], references: [id])
  receiptVoucher   Voucher?    @relation(fields: [receiptVoucherId], references: [id])

  @@unique([sponsorId, year], map: "one_payment_per_sponsor_per_year")
  @@index([year], map: "payments_year")
  @@index([sponsorId], map: "payments_sponsor")
  @@map("sanththa_payments")
}

/// A sign-in. Credentials only — the name, phone and address belong to the
/// party this account is for.
model UserAccount {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyId      Int         @unique(map: "user_accounts_party_id_key") @map("party_id")
  email        String      @unique(map: "user_accounts_email_key") @db.Citext
  passwordHash String      @map("password_hash")
  role         AccountRole
  isActive     Boolean     @default(true) @map("is_active")
  lastLoginAt  DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  party               Party                   @relation(fields: [partyId], references: [id])
  sessions            UserSession[]
  closedFinancialYear FinancialYear[]
  vouchersCreated     Voucher[]               @relation("VoucherCreatedBy")
  vouchersDecided     Voucher[]               @relation("VoucherDecidedBy")
  subscriptionsTaken  SanththaPayment[]       @relation("SanththaCollector")
  ratesSet            SanththaRate[]
  auditEntries        AuditLog[]
  notifications       NotificationRecipient[]
  settingsUpdated     Setting[]

  @@index([role], map: "user_accounts_role")
  @@map("user_accounts")
}

model UserSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "user_sessions_token_hash_key") @map("token_hash")
  deviceName String    @map("device_name")
  ipAddress  String    @map("ip_address") @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  account UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "user_sessions_expiry")
  @@map("user_sessions")
}

model Role {
  code        AccountRole @id
  label       String
  description String
  isSystem    Boolean     @default(false) @map("is_system")
  sortOrder   Int         @default(0) @map("sort_order") @db.SmallInt

  permissions RolePermission[]

  @@map("roles")
}

model PermissionGroup {
  code        String @id
  label       String
  description String
  sortOrder   Int    @default(0) @map("sort_order") @db.SmallInt

  permissions Permission[]

  @@map("permission_groups")
}

model Permission {
  code      String @id
  groupCode String @map("group_code")
  label     String
  sortOrder Int    @default(0) @map("sort_order") @db.SmallInt

  group PermissionGroup  @relation(fields: [groupCode], references: [code])
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleCode       AccountRole @map("role_code")
  permissionCode String      @map("permission_code")

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

model FinancialYear {
  id             Int                 @id @default(autoincrement())
  label          String              @unique(map: "financial_years_label_key")
  startsOn       DateTime            @map("starts_on") @db.Date
  endsOn         DateTime            @map("ends_on") @db.Date
  status         FinancialYearStatus @default(upcoming)
  isCurrent      Boolean             @default(false) @map("is_current")
  openingBalance Decimal             @default(0) @map("opening_balance") @db.Decimal(14, 2)
  income         Decimal?            @db.Decimal(14, 2)
  expenses       Decimal?            @db.Decimal(14, 2)
  voucherCount   Int?                @map("voucher_count")
  closedOn       DateTime?           @map("closed_on") @db.Timestamptz(6)
  closedBy       String?             @map("closed_by") @db.Uuid

  closedByUser UserAccount?      @relation(fields: [closedBy], references: [id])
  vouchers     Voucher[]
  sequences    VoucherSequence[]

  @@map("financial_years")
}

model Account {
  id             Int         @id @default(autoincrement())
  code           String      @unique(map: "accounts_code_key")
  nameTa         String      @map("name_ta")
  nameEn         String?     @map("name_en")
  type           AccountType
  parentId       Int?        @map("parent_id")
  isPostable     Boolean     @default(true) @map("is_postable")
  isActive       Boolean     @default(true) @map("is_active")
  openingBalance Decimal     @default(0) @map("opening_balance") @db.Decimal(14, 2)
  /// Only for heads that deal with exactly one party — electricity, water,
  /// rates. Never on a shared head like salaries. A default, not a rule.
  defaultPartyId Int?        @map("default_party_id")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  parent               Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children             Account[]     @relation("AccountTree")
  defaultParty         Party?        @relation("AccountDefaultParty", fields: [defaultPartyId], references: [id])
  bankAccount          BankAccount?
  voucherLines         VoucherLine[]
  ledgerLines          LedgerEntry[]
  defaultForActivities Activity[]    @relation("ActivityDefaultAccount")

  @@index([parentId], map: "accounts_parent")
  @@index([defaultPartyId], map: "accounts_default_party")
  @@map("accounts")
}

model Fund {
  id             Int      @id @default(autoincrement())
  nameTa         String   @unique(map: "funds_name_ta_key") @map("name_ta")
  nameEn         String?  @map("name_en")
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  projects     Project[]
  voucherLines VoucherLine[]
  ledgerLines  LedgerEntry[]
  deposits     FixedDeposit[]
  assets       Asset[]
  activities   Activity[]

  @@map("funds")
}

model Project {
  id          Int           @id @default(autoincrement())
  nameTa      String        @map("name_ta")
  nameEn      String?       @map("name_en")
  fundId      Int           @map("fund_id")
  budget      Decimal?      @db.Decimal(14, 2)
  startDate   DateTime      @map("start_date") @db.Date
  targetDate  DateTime?     @map("target_date") @db.Date
  status      ProjectStatus @default(planning)
  description String        @default("")
  isActive    Boolean       @default(true) @map("is_active")

  fund         Fund          @relation(fields: [fundId], references: [id])
  voucherLines VoucherLine[]
  ledgerLines  LedgerEntry[]
  activities   Activity[]

  @@index([fundId, status], map: "projects_fund")
  @@map("projects")
}

/// What an entry was for. Both income and expenditure carry one, which is what
/// lets a pooja be read as a whole — sponsorship in against priest time out.
model Activity {
  id               Int          @id @default(autoincrement())
  nameTa           String       @unique(map: "activities_name_ta_key") @map("name_ta")
  nameEn           String?      @map("name_en")
  kind             ActivityKind @default(general)
  /// The coding a line takes when this activity is chosen. All four stay
  /// editable on the entry itself: a default is what is usually true.
  defaultFundId    Int?         @map("default_fund_id")
  defaultProjectId Int?         @map("default_project_id")
  defaultPartyId   Int?         @map("default_party_id")
  /// The head this activity normally lands on. One column, not one per side:
  /// `account.type` already says whether it suits a receipt or a payment.
  defaultAccountId Int?         @map("default_account_id")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  defaultFund    Fund?    @relation(fields: [defaultFundId], references: [id])
  defaultProject Project? @relation(fields: [defaultProjectId], references: [id])
  defaultParty   Party?   @relation("ActivityDefaultParty", fields: [defaultPartyId], references: [id])
  defaultAccount Account? @relation("ActivityDefaultAccount", fields: [defaultAccountId], references: [id])

  eventTypes   EventType[]
  voucherLines VoucherLine[]
  ledgerLines  LedgerEntry[]

  @@index([kind, isActive], map: "activities_kind")
  @@index([defaultFundId], map: "activities_default_fund")
  @@index([defaultProjectId], map: "activities_default_project")
  @@index([defaultPartyId], map: "activities_default_party")
  @@index([defaultAccountId], map: "activities_default_account")
  @@map("activities")
}

model BankAccount {
  id              Int             @id @default(autoincrement())
  label           String
  bankName        String          @map("bank_name")
  branch          String
  accountNumber   String          @map("account_number")
  type            BankAccountType
  openingBalance  Decimal         @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openedOn        DateTime        @map("opened_on") @db.Date
  isActive        Boolean         @default(true) @map("is_active")
  ledgerAccountId Int             @unique(map: "bank_accounts_ledger_account_id_key") @map("ledger_account_id")

  ledgerAccount Account        @relation(fields: [ledgerAccountId], references: [id])
  vouchers      Voucher[]
  ledgerLines   LedgerEntry[]
  deposits      FixedDeposit[]

  @@unique([bankName, accountNumber], map: "bank_account_number")
  @@map("bank_accounts")
}

model Voucher {
  id              BigInt        @id @default(autoincrement())
  ref             String        @unique(map: "vouchers_ref_key")
  kind            VoucherKind
  financialYearId Int           @map("financial_year_id")
  date            DateTime      @db.Date
  description     String
  amount          Decimal       @db.Decimal(14, 2)
  mode            PaymentMode
  bankAccountId   Int?          @map("bank_account_id")
  chequeNo        String?       @map("cheque_no")
  partyId         Int?          @map("party_id")
  /// The name as it stood when the entry was made. Kept alongside `partyId` so
  /// a walk-in donor needs no record, and a later rename cannot rewrite a
  /// posted receipt.
  party           String
  manualVoucherNo String?       @map("manual_voucher_no")
  status          VoucherStatus @default(Draft)
  notes           String?
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt     DateTime?     @map("submitted_at") @db.Timestamptz(6)
  decidedBy       String?       @map("decided_by") @db.Uuid
  decidedAt       DateTime?     @map("decided_at") @db.Timestamptz(6)
  rejectionReason String?       @map("rejection_reason")
  postedAt        DateTime?     @map("posted_at") @db.Timestamptz(6)

  financialYear   FinancialYear     @relation(fields: [financialYearId], references: [id])
  partyRef        Party?            @relation(fields: [partyId], references: [id])
  bankAccount     BankAccount?      @relation(fields: [bankAccountId], references: [id])
  lines           VoucherLine[]
  createdByUser   UserAccount       @relation("VoucherCreatedBy", fields: [createdBy], references: [id])
  decidedByUser   UserAccount?      @relation("VoucherDecidedBy", fields: [decidedBy], references: [id])
  ledgerEntries   LedgerEntry[]
  sanththaPayment SanththaPayment?

  @@index([financialYearId, date(sort: Desc)], map: "vouchers_year_date")
  @@index([kind, date(sort: Desc)], map: "vouchers_kind_date")
  @@index([partyId], map: "vouchers_party")
  @@index([bankAccountId], map: "vouchers_bank_account")
  @@index([createdBy], map: "vouchers_created_by")
  @@index([party(ops: raw("gin_trgm_ops"))], map: "vouchers_party_text", type: Gin)
  @@map("vouchers")
}

/// One head a voucher is coded to. No debit/credit column: every line of a
/// receipt credits income and every line of a payment debits expenditure, which
/// follows from `voucher.kind`.
model VoucherLine {
  id         BigInt   @id @default(autoincrement())
  voucherId  BigInt   @map("voucher_id")
  lineNo     Int      @map("line_no") @db.SmallInt
  accountId  Int      @map("account_id")
  amount     Decimal  @db.Decimal(14, 2)
  fundId     Int      @map("fund_id")
  projectId  Int?     @map("project_id")
  activityId Int?     @map("activity_id")
  eventId    Int?     @map("event_id")

  voucher  Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id])
  fund     Fund      @relation(fields: [fundId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id])
  activity Activity? @relation(fields: [activityId], references: [id])
  event    Event?    @relation(fields: [eventId], references: [id])

  @@unique([voucherId, lineNo], map: "voucher_line_no")
  @@index([accountId], map: "voucher_lines_account")
  @@index([activityId], map: "voucher_lines_activity")
  @@index([fundId], map: "voucher_lines_fund")
  @@index([projectId], map: "voucher_lines_project")
  @@index([eventId], map: "voucher_lines_event")
  @@map("voucher_lines")
}

model VoucherSequence {
  financialYearId Int         @map("financial_year_id")
  kind            VoucherKind
  prefix          String
  nextNo          Int         @default(1) @map("next_no")

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@id([financialYearId, kind])
  @@map("voucher_sequences")
}

model LedgerEntry {
  id            BigInt   @id @default(autoincrement())
  voucherId     BigInt   @map("voucher_id")
  lineNo        Int      @map("line_no") @db.SmallInt
  date          DateTime @db.Date
  accountId     Int      @map("account_id")
  fundId        Int      @map("fund_id")
  projectId     Int?     @map("project_id")
  /// Carried only on the income or expense line, never on its cash or bank
  /// contra. Both sides bearing these would net to nil.
  activityId    Int?     @map("activity_id")
  partyId       Int?     @map("party_id")
  eventId       Int?     @map("event_id")
  debit         Decimal? @db.Decimal(14, 2)
  credit        Decimal? @db.Decimal(14, 2)
  bankAccountId Int?     @map("bank_account_id")

  voucher     Voucher      @relation(fields: [voucherId], references: [id])
  account     Account      @relation(fields: [accountId], references: [id])
  fund        Fund         @relation(fields: [fundId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id])
  activity    Activity?    @relation(fields: [activityId], references: [id])
  party       Party?       @relation(fields: [partyId], references: [id])
  event       Event?       @relation(fields: [eventId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@unique([voucherId, lineNo], map: "voucher_line")
  @@index([accountId, date], map: "ledger_account_date")
  @@index([fundId, date], map: "ledger_fund_date")
  @@index([projectId], map: "ledger_entries_project")
  @@index([bankAccountId], map: "ledger_entries_bank_account")
  @@index([activityId, date], map: "ledger_activity_date")
  @@index([partyId, date], map: "ledger_party_date")
  @@index([eventId], map: "ledger_event")
  @@index([date], map: "ledger_date")
  @@map("ledger_entries")
}

model FixedDeposit {
  id             Int            @id @default(autoincrement())
  certificateNo  String         @unique(map: "fixed_deposits_certificate_no_key") @map("certificate_no")
  bankName       String         @map("bank_name")
  branch         String
  principal      Decimal        @db.Decimal(14, 2)
  interestRate   Decimal        @map("interest_rate") @db.Decimal(5, 2)
  placedOn       DateTime       @map("placed_on") @db.Date
  maturesOn      DateTime       @map("matures_on") @db.Date
  tenureMonths   Int            @map("tenure_months") @db.SmallInt
  interestPayout InterestPayout @map("interest_payout")
  fundId         Int            @map("fund_id")
  status         DepositStatus  @default(active)
  renewedFromId  Int?           @map("renewed_from_id")
  bankAccountId  Int?           @map("bank_account_id")
  notes          String?

  fund        Fund           @relation(fields: [fundId], references: [id])
  bankAccount BankAccount?   @relation(fields: [bankAccountId], references: [id])
  renewedFrom FixedDeposit?  @relation("DepositRenewal", fields: [renewedFromId], references: [id])
  renewals    FixedDeposit[] @relation("DepositRenewal")

  @@index([status, maturesOn], map: "deposits_maturing")
  @@map("fixed_deposits")
}

model Asset {
  id               Int            @id @default(autoincrement())
  tag              String         @unique(map: "assets_tag_key")
  nameTa           String         @map("name_ta")
  nameEn           String?        @map("name_en")
  category         AssetCategory
  acquiredOn       DateTime       @map("acquired_on") @db.Date
  cost             Decimal        @db.Decimal(14, 2)
  depreciationRate Decimal        @default(0) @map("depreciation_rate") @db.Decimal(5, 2)
  location         String
  condition        AssetCondition @default(good)
  status           AssetStatus    @default(inUse)
  fundId           Int            @map("fund_id")
  disposedOn       DateTime?      @map("disposed_on") @db.Date
  disposalValue    Decimal?       @map("disposal_value") @db.Decimal(14, 2)
  notes            String?

  fund Fund @relation(fields: [fundId], references: [id])

  @@index([category, status], map: "assets_category")
  @@map("assets")
}

model EventType {
  id            Int           @id @default(autoincrement())
  nameTa        String        @unique(map: "event_types_name_ta_key") @map("name_ta")
  nameEn        String?       @map("name_en")
  frequencyType FrequencyType @map("frequency_type")
  noOfInstances Int           @default(1) @map("no_of_instances") @db.SmallInt
  /// `general` observances are funded by village collection and never carry a
  /// named sponsor, which is what separates "no sponsor by design" from
  /// "nobody assigned yet".
  funding       EventFunding  @default(sponsored)
  activityId    Int?          @map("activity_id")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  activity Activity? @relation(fields: [activityId], references: [id])

  slots    EventSlot[]
  sponsors EventTypeSponsor[]

  @@index([activityId], map: "event_types_activity")
  @@index([funding], map: "event_types_funding")
  @@map("event_types")
}

/// One slot of a recurring observance — Week 12, or the மார்கழி occurrence.
/// Dated afresh every year by its `Event` rows.
model EventSlot {
  id                 Int     @id @default(autoincrement())
  eventTypeId        Int     @map("event_type_id")
  instanceIdentifier Int     @map("instance_identifier") @db.SmallInt
  customInstanceName String? @map("custom_instance_name")
  isActive           Boolean @default(true) @map("is_active")

  eventType EventType          @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  sponsors  EventTypeSponsor[]
  events    Event[]

  @@unique([eventTypeId, instanceIdentifier], map: "one_slot_per_instance")
  @@map("event_slots")
}

/// Who may take a slot — the arrangement, with no year attached. A null slot is
/// a registered sponsor not yet placed, not "every slot".
model EventTypeSponsor {
  id          Int      @id @default(autoincrement())
  eventTypeId Int      @map("event_type_id")
  slotId      Int?     @map("slot_id")
  partyId     Int      @map("party_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  eventType EventType  @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  slot      EventSlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)
  party     Party      @relation(fields: [partyId], references: [id])

  @@unique([eventTypeId, slotId, partyId], map: "one_sponsor_per_slot")
  @@index([partyId], map: "sponsors_by_party")
  @@index([slotId], map: "sponsors_by_slot")
  @@map("event_type_sponsors")
}

/// One dated occurrence of one slot. `sponsorPartyId` is null for a `general`
/// event type, and for a `sponsored` one means nobody has been placed yet.
model Event {
  id             Int       @id @default(autoincrement())
  slotId         Int       @map("slot_id")
  scheduledDate  DateTime  @map("scheduled_date") @db.Date
  startTime      DateTime  @map("start_time") @db.Time(6)
  endTime        DateTime? @map("end_time") @db.Time(6)
  sponsorPartyId Int?      @map("sponsor_party_id")
  notes          String?
  isCompleted    Boolean   @default(false) @map("is_completed")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  slot         EventSlot     @relation(fields: [slotId], references: [id])
  sponsor      Party?        @relation(fields: [sponsorPartyId], references: [id])
  voucherLines VoucherLine[]
  ledgerLines  LedgerEntry[]

  // `one_occurrence_per_slot_year` is an expression index and lives in the
  // integrity migration; Prisma cannot express it.
  @@index([scheduledDate], map: "events_calendar")
  @@index([sponsorPartyId], map: "events_sponsor")
  @@map("events")
}

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  at        DateTime    @default(now()) @db.Timestamptz(6)
  actorId   String?     @map("actor_id") @db.Uuid
  actorName String      @map("actor_name")
  actorRole AccountRole @map("actor_role")
  action    AuditAction
  entity    String
  entityRef String?     @map("entity_ref")
  summary   String
  ipAddress String      @map("ip_address") @db.Inet
  diff      Json?

  actor UserAccount? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at(sort: Desc)], map: "audit_recent")
  @@index([actorId, at(sort: Desc)], map: "audit_actor")
  @@index([entity, entityRef], map: "audit_entity")
  @@map("audit_log")
}

model Notification {
  id          BigInt               @id @default(autoincrement())
  category    NotificationCategory
  priority    NotificationPriority @default(Information)
  title       String
  message     String
  entityType  String?              @map("entity_type")
  entityRef   String?              @map("entity_ref")
  actionLabel String?              @map("action_label")
  actionHref  String?              @map("action_href")
  meta        Json?
  dismissible Boolean              @default(true)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  recipients NotificationRecipient[]

  @@index([createdAt(sort: Desc)], map: "notifications_recent")
  @@map("notifications")
}

model NotificationRecipient {
  notificationId BigInt    @map("notification_id")
  userId         String    @map("user_id") @db.Uuid
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  dismissedAt    DateTime? @map("dismissed_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  account      UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@map("notification_recipients")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  updatedByAccount UserAccount? @relation(fields: [updatedBy], references: [id])

  @@map("settings")
}
